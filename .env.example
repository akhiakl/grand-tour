# Groq — AI trip generation (server-side only, never exposed to the client)
GROQ_API_KEY=

# Upstash Redis — shared trip snapshots + rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry monitoring (optional — everything is a no-op when unset).
# DSN is safe to expose; it only accepts events.
NEXT_PUBLIC_SENTRY_DSN=
# CI-only, for source-map upload:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
