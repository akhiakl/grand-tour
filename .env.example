# Public site origin for absolute metadata URLs (OG images, sitemap, robots).
# Falls back to Vercel's production host, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# AI trip generation — any OpenAI-compatible endpoint (server-side only).
# e.g. Ollama: AI_BASE_URL=http://localhost:11434/v1 AI_MODEL=qwen3:14b
# Prefer open-weight models under an OSI license (Qwen, gpt-oss, Mistral).
AI_BASE_URL=
AI_MODEL=
# Optional; omitted from requests when empty (local Ollama needs none).
AI_API_KEY=
# Optional, sent only when set. For reasoning models (e.g. gpt-oss on Groq):
# low|medium|high, and a cap high enough for the JSON after reasoning.
AI_REASONING_EFFORT=
AI_MAX_TOKENS=

# Upstash Redis — shared trip snapshots + rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Map basemap (optional). Defaults to public OpenFreeMap; set to a
# self-hosted MapLibre style URL (OpenFreeMap, Protomaps, ...) to replace it.
# The CSP allows only this URL's origin, so tiles/glyphs/sprites must share it.
NEXT_PUBLIC_MAP_STYLE_URL=

# Exchange rates for budget display (optional). Defaults to Frankfurter
# (open-source ECB rates, no key); point at a self-hosted instance with
# the same `/latest?base=USD` response shape to replace it.
RATES_API_URL=

# Better Stack server logs (optional — logs still print to the console when
# unset). Server-only: never prefix these with NEXT_PUBLIC_.
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_URL=

# Sentry monitoring (optional — everything is a no-op when unset).
# DSN is safe to expose; it only accepts events.
NEXT_PUBLIC_SENTRY_DSN=
# CI-only, for source-map upload:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
